# Copy to .env for local runs (never commit .env). In GitHub Actions,
# set these under Settings -> Secrets and variables -> Actions.

# --- Secrets ---
INSTANTLY_API_KEY=your-instantly-v2-api-key
MAILERLITE_API_KEY=your-mailerlite-api-key

# Optional summary email (sent only when something was added or failed)
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_NOTIFY=you@example.com

# --- Configuration (optional) ---
# Override a group ID from config/routing.json, one variable per segment:
# MAILERLITE_GROUP_WHOLESALE=000000000000000001
# MAILERLITE_GROUP_INTERNATIONAL=000000000000000002
# CONFIG_DIR=./config
# STATE_DIR=./state
